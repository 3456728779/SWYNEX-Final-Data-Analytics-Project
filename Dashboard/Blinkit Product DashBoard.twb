      <aliases enabled='yes' />
      <column caption='Discount Amount' datatype='real' name='[Calculation_4932667021668352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[price] - [final_price]' />
      </column>
      <column caption='Sales Value' datatype='real' name='[Calculation_4932667021803521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[final_price] * [sold_quantity]' />
      </column>
      <column caption='Profit Amount' datatype='real' name='[Calculation_4932667021910018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4932667021803521] * [profit_margin_pct] / 100' />
      </column>
      <column caption='Discount Category' datatype='string' name='[Calculation_4932667022012419]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [discount_pct] = 0 THEN &quot;No Discount&quot;&#10;ELSEIF [discount_pct] &lt;= 10 THEN &quot;Low Discount&quot;&#10;ELSEIF [discount_pct] &lt;= 20 THEN &quot;Medium Discount&quot;&#10;ELSE &quot;High Discount&quot;&#10;END' />
      </column>
      <column caption='Demand Category' datatype='string' name='[Calculation_4932667022315526]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [demand_index] &gt;= 80 THEN &quot;High Demand&quot;&#10;ELSEIF [demand_index] &gt;= 50 THEN &quot;Medium Demand&quot;&#10;ELSE &quot;Low Demand&quot;&#10;END' />
      </column>
      <column caption='Selected KPI' datatype='real' name='[Calculation_4932667023605768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4932667023015943]&#10;&#10;WHEN &quot;Total Sold Quantity&quot; THEN SUM([sold_quantity])&#10;WHEN &quot;Average Price&quot; THEN AVG([price])&#10;WHEN &quot;Average Rating&quot; THEN AVG([rating])&#10;WHEN &quot;Average Delivery Time&quot; THEN AVG([delivery_time_min])&#10;WHEN &quot;Profit Margin&quot; THEN AVG([profit_margin_pct])&#10;&#10;END' />
      </column>
      <column caption='Top N Filter' datatype='boolean' name='[Calculation_4932667024609290]' role='measure' type='nominal'>
