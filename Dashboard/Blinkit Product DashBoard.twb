          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top 10 Products' datatype='boolean' name='[Calculation_5058836847390724]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([sold_quantity])) &lt;= [Parameters].[Parameter 4932667024334857]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Sales' datatype='real' name='[Calculation_5298393484029952]' role='measure' type='quantitative'>
